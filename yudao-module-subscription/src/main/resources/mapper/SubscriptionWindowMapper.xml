<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.subscription.dal.mysql.SubscriptionWindowMapper">

    <select id="getWindowMutationLock" resultType="java.lang.Integer">
        SELECT GET_LOCK(#{lockName}, #{timeoutSeconds})
    </select>

    <select id="releaseWindowMutationLock" resultType="java.lang.Integer">
        SELECT RELEASE_LOCK(#{lockName})
    </select>

</mapper>

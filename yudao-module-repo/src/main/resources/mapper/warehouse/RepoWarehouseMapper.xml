<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.repo.dal.mysql.warehouse.RepoWarehouseMapper">

    <select id="countBoundSchoolByWarehouseId" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM edu_school
        WHERE deleted = FALSE
          AND warehouse_id = #{warehouseId}
    </select>

</mapper>

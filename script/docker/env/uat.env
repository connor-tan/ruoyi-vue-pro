COMPOSE_PROJECT_NAME=xiaokanhui-uat

IMAGE_TAG=uat
SERVER_IMAGE_REPO=yudao-server
ADMIN_IMAGE_REPO=yudao-admin
APP_IMAGE_REPO=yudao-mall-uniapp-h5

GATEWAY_DOMAIN_BIND_HOST=0.0.0.0
GATEWAY_FALLBACK_BIND_HOST=0.0.0.0
GATEWAY_HTTP_PORT=38080
GATEWAY_ADMIN_PORT=38081
GATEWAY_H5_PORT=38082
GATEWAY_API_PORT=38083

ADMIN_DOMAIN=admin.uat.localhost
H5_DOMAIN=h5.uat.localhost
API_DOMAIN=api.uat.localhost

ADMIN_BIND_HOST=127.0.0.1
ADMIN_PORT=38088
APP_BIND_HOST=127.0.0.1
APP_PORT=33000
H5_PUBLIC_URL=http://127.0.0.1:38082
MP_BASE_URL=http://127.0.0.1:38083
MP_H5_URL=http://127.0.0.1:38082
APP_STATIC_URL=local
APP_MPLIVE_ON=0
APP_TENANT_ID=1

SPRING_PROFILES_ACTIVE=docker
JAVA_OPTS=-Xms512m -Xmx512m -Djava.security.egd=file:/dev/./urandom
MAVEN_BUILD_ARGS=
SERVER_EXTRA_ARGS=

MYSQL_DATABASE=ruoyi-vue-pro
MYSQL_ROOT_PASSWORD=uat-123456
MYSQL_BIND_HOST=127.0.0.1
MYSQL_MASTER_HOST_PORT=33307
MYSQL_SLAVE_HOST_PORT=33308
MYSQL_MASTER_HOST=mysql-master
MYSQL_MASTER_PORT=3306
MYSQL_SLAVE_HOST=mysql-slave
MYSQL_SLAVE_PORT=3306
REPLICATION_USER=repl
REPLICATION_PASSWORD=repl-uat-123456
REPLICA_RESEED_ON_INIT=true

REDIS_BIND_HOST=127.0.0.1
REDIS_HOST_PORT=36379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=5
REDIS_PASSWORD=uat-redis-123456

FILE_STORAGE_HOST_PATH=/mnt/data/workspace/xiaokanhui/uat/files

QUARTZ_AUTO_STARTUP=true
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info

ADMIN_BUILD_MODE=prod
ADMIN_TITLE=校刊汇 UAT 环境

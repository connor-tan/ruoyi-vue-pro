COMPOSE_PROJECT_NAME=xiaokanhui-prod

IMAGE_TAG=prod
SERVER_IMAGE_REPO=yudao-server
ADMIN_IMAGE_REPO=yudao-admin
APP_IMAGE_REPO=yudao-mall-uniapp-h5

GATEWAY_DOMAIN_BIND_HOST=0.0.0.0
GATEWAY_FALLBACK_BIND_HOST=127.0.0.1
GATEWAY_HTTP_PORT=80
GATEWAY_ADMIN_PORT=48081
GATEWAY_H5_PORT=48082
GATEWAY_API_PORT=48083

ADMIN_DOMAIN=admin.xiaokanhui.com
H5_DOMAIN=h5.xiaokanhui.com
API_DOMAIN=api.xiaokanhui.com

ADMIN_BIND_HOST=127.0.0.1
ADMIN_PORT=48088
APP_BIND_HOST=127.0.0.1
APP_PORT=43000
H5_PUBLIC_URL=https://h5.xiaokanhui.com
MP_BASE_URL=https://api.xiaokanhui.com
MP_H5_URL=https://h5.xiaokanhui.com
APP_STATIC_URL=local
APP_MPLIVE_ON=0
APP_TENANT_ID=1

SPRING_PROFILES_ACTIVE=docker
JAVA_OPTS=-Xms1g -Xmx1g -Djava.security.egd=file:/dev/./urandom
MAVEN_BUILD_ARGS=
SERVER_EXTRA_ARGS=

MYSQL_DATABASE=ruoyi-vue-pro
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
MYSQL_BIND_HOST=127.0.0.1
MYSQL_MASTER_HOST_PORT=43307
MYSQL_SLAVE_HOST_PORT=43308
MYSQL_MASTER_HOST=mysql-master
MYSQL_MASTER_PORT=3306
MYSQL_SLAVE_HOST=mysql-slave
MYSQL_SLAVE_PORT=3306
REPLICATION_USER=repl
REPLICATION_PASSWORD=CHANGE_ME_REPLICATION_PASSWORD
REPLICA_RESEED_ON_INIT=true

REDIS_BIND_HOST=127.0.0.1
REDIS_HOST_PORT=46379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=5
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

FILE_STORAGE_HOST_PATH=/mnt/data/workspace/xiaokanhui/prod/files

QUARTZ_AUTO_STARTUP=true
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info

ADMIN_BUILD_MODE=prod
ADMIN_TITLE=校刊汇管理系统

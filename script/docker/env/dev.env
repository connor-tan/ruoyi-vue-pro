COMPOSE_PROJECT_NAME=xiaokanhui-dev

IMAGE_TAG=dev
SERVER_IMAGE_REPO=yudao-server
ADMIN_IMAGE_REPO=yudao-admin
APP_IMAGE_REPO=yudao-mall-uniapp-h5

GATEWAY_DOMAIN_BIND_HOST=0.0.0.0
GATEWAY_FALLBACK_BIND_HOST=0.0.0.0
GATEWAY_HTTP_PORT=18080
GATEWAY_HTTPS_PORT=18443
GATEWAY_ADMIN_PORT=18081
GATEWAY_H5_PORT=18082
GATEWAY_API_PORT=18083
GATEWAY_TEMPLATE=edge-gateway.conf.template

ADMIN_DOMAIN=admin.dev.localhost
H5_DOMAIN=h5.dev.localhost
API_DOMAIN=api.dev.localhost
WWW_DOMAIN=www.dev.localhost
CERTBOT_CERT_NAME=xiaokanhui-dev
LETSENCRYPT_HOST_PATH=./certbot/conf
CERTBOT_WEBROOT_HOST_PATH=./certbot/www
NGINX_RELOAD_INTERVAL_SECONDS=43200

ADMIN_BIND_HOST=127.0.0.1
ADMIN_PORT=8080
APP_BIND_HOST=127.0.0.1
APP_PORT=3000
H5_PUBLIC_URL=http://localhost:18082
MP_BASE_URL=http://localhost:18083
MP_H5_URL=http://localhost:18082
APP_STATIC_URL=local
APP_MPLIVE_ON=0
APP_TENANT_ID=1

SPRING_PROFILES_ACTIVE=docker
JAVA_OPTS=-Xms512m -Xmx512m -Djava.security.egd=file:/dev/./urandom
MAVEN_BUILD_ARGS=
SERVER_EXTRA_ARGS=

MYSQL_DATABASE=ruoyi-vue-pro
MYSQL_ROOT_PASSWORD=123456
MYSQL_BIND_HOST=127.0.0.1
MYSQL_MASTER_HOST_PORT=3307
MYSQL_SLAVE_HOST_PORT=3308
MYSQL_MASTER_HOST=mysql-master
MYSQL_MASTER_PORT=3306
MYSQL_SLAVE_HOST=mysql-slave
MYSQL_SLAVE_PORT=3306
REPLICATION_USER=repl
REPLICATION_PASSWORD=repl123456
REPLICA_RESEED_ON_INIT=true

REDIS_BIND_HOST=127.0.0.1
REDIS_HOST_PORT=6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=5
REDIS_PASSWORD=

FILE_STORAGE_HOST_PATH=/mnt/data/workspace/xiaokanhui/dev/files

QUARTZ_AUTO_STARTUP=true
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info

ADMIN_BUILD_MODE=prod
ADMIN_TITLE=校刊汇管理系统

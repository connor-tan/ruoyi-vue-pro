COMPOSE_PROJECT_NAME=xiaokanhui-test

IMAGE_TAG=test
SERVER_IMAGE_REPO=yudao-server
ADMIN_IMAGE_REPO=yudao-admin
APP_IMAGE_REPO=yudao-mall-uniapp-h5

GATEWAY_DOMAIN_BIND_HOST=0.0.0.0
GATEWAY_FALLBACK_BIND_HOST=0.0.0.0
GATEWAY_HTTP_PORT=28080
GATEWAY_ADMIN_PORT=28081
GATEWAY_H5_PORT=28082
GATEWAY_API_PORT=28083

ADMIN_DOMAIN=admin.test.localhost
H5_DOMAIN=h5.test.localhost
API_DOMAIN=api.test.localhost

ADMIN_BIND_HOST=127.0.0.1
ADMIN_PORT=28088
APP_BIND_HOST=127.0.0.1
APP_PORT=23000
H5_PUBLIC_URL=http://127.0.0.1:28082
MP_BASE_URL=http://127.0.0.1:28083
MP_H5_URL=http://127.0.0.1:28082
APP_STATIC_URL=local
APP_MPLIVE_ON=0
APP_TENANT_ID=1

SPRING_PROFILES_ACTIVE=docker
JAVA_OPTS=-Xms512m -Xmx512m -Djava.security.egd=file:/dev/./urandom
MAVEN_BUILD_ARGS=
SERVER_EXTRA_ARGS=

MYSQL_DATABASE=ruoyi-vue-pro
MYSQL_ROOT_PASSWORD=test-123456
MYSQL_BIND_HOST=127.0.0.1
MYSQL_MASTER_HOST_PORT=23307
MYSQL_SLAVE_HOST_PORT=23308
MYSQL_MASTER_HOST=mysql-master
MYSQL_MASTER_PORT=3306
MYSQL_SLAVE_HOST=mysql-slave
MYSQL_SLAVE_PORT=3306
REPLICATION_USER=repl
REPLICATION_PASSWORD=repl-test-123456
REPLICA_RESEED_ON_INIT=true

REDIS_BIND_HOST=127.0.0.1
REDIS_HOST_PORT=26379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=5
REDIS_PASSWORD=test-redis-123456

FILE_STORAGE_HOST_PATH=/mnt/data/workspace/xiaokanhui/test/files

QUARTZ_AUTO_STARTUP=true
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info

ADMIN_BUILD_MODE=prod
ADMIN_TITLE=校刊汇测试环境
